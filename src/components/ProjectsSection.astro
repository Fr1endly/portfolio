---
const featuredProjects = [
  {
    id: "sbs",
    number: "01",
    title: "Side by Side",
    type: "Web experience",
    year: "2024",
    image: "/images/design/sbs-homepage.png",
    imageAlt: "Side by Side website interface",
    accent: "#2f6edb",
  },
  {
    id: "rd",
    number: "02",
    title: "Resistance Diary",
    type: "Progressive web app",
    year: "2025",
    image: "/images/design/rd-homepage.png",
    imageAlt: "Resistance Diary mobile app interface",
    accent: "#ffad27",
  },
];

const placeholderProjects = Array.from({ length: 10 }, (_, index) => ({
  id: `open-${index + 1}`,
  number: String(index + 3).padStart(2, "0"),
  title: "Place for your project",
  type: "Available slot",
  year: "Let's talk",
  image: null,
  imageAlt: "",
  accent: index % 2 === 0 ? "#2f6edb" : "#ffad27",
}));

const projects = [...featuredProjects, ...placeholderProjects];
---

<section
  id="projects"
  class="projects-carousel"
  aria-labelledby="projects-heading"
  data-project-carousel
>
  <header class="projects-carousel__header">
    <p>Layer 03 / Projects</p>
    <p>{String(featuredProjects.length).padStart(2, "0")} selected / {String(placeholderProjects.length).padStart(2, "0")} open</p>
  </header>

  <div class="projects-carousel__stage" data-carousel-stage>
    <div class="projects-carousel__intro">
      <p>Selected</p>
      <h2 id="projects-heading">Work</h2>
      <span>2024 / 2025</span>
    </div>

    <div class="projects-carousel__path" aria-hidden="true"></div>

    {
      projects.map((project, index) => (
        <div
          class="projects-carousel__item"
          data-carousel-item
          data-index={index}
        >
          <a
            class="project-card"
            href={project.image ? `/projects/${project.id}` : "mailto:gizatulinso@gmail.com?subject=Project%20inquiry"}
            style={`--project-accent: ${project.accent}`}
            aria-label={project.image ? `View ${project.title} case study` : "Get in touch about your project"}
          >
            {
              project.image ? (
                <div class="project-card__image">
                  <img src={project.image} alt={project.imageAlt} loading="lazy" />
                </div>
              ) : (
                <div class="project-card__placeholder" aria-hidden="true">
                  <span>Place for</span>
                  <strong>your project</strong>
                </div>
              )
            }
            <div class="project-card__details">
              <div>
                <span class="project-card__number">{project.number}</span>
                <h3>{project.title}</h3>
              </div>
              <div class="project-card__meta">
                <span>{project.type}</span>
                <span>{project.year} &#8599;</span>
              </div>
            </div>
          </a>
        </div>
      ))
    }
  </div>

  <p class="projects-carousel__status" aria-live="polite" data-carousel-status>
    Projects rotate clockwise. Hover or focus a project to pause.
  </p>
</section>

<script>
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-project-carousel]").forEach((carousel) => {
    const stage = carousel.querySelector<HTMLElement>("[data-carousel-stage]");
    const items = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-item]"));
    const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");

    if (!stage || items.length === 0) return;

    let angle = -Math.PI / 2;
    let previousTime = performance.now();
    let animationFrame = 0;
    let isCardActive = false;
    let isVisible = true;

    const positionItems = () => {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      const radiusX = Math.max(0, width * (width < 700 ? 0.22 : 0.34));
      const radiusY = Math.max(0, height * (width < 700 ? 0.31 : 0.32));

      items.forEach((item, index) => {
        const itemAngle = angle + (index / items.length) * Math.PI * 2;
        const x = Math.cos(itemAngle) * radiusX;
        const y = Math.sin(itemAngle) * radiusY;
        const depth = (Math.sin(itemAngle) + 1) / 2;

        item.style.setProperty("--carousel-x", `${x}px`);
        item.style.setProperty("--carousel-y", `${y}px`);
        item.style.setProperty("--carousel-scale", String(0.88 + depth * 0.12));
        item.style.zIndex = String(2 + Math.round(depth * 10));
      });
    };

    const animate = (time: number) => {
      const elapsed = Math.min(time - previousTime, 40);
      previousTime = time;

      if (!isCardActive && isVisible && !motionPreference.matches) {
        angle += elapsed * 0.000055;
        positionItems();
      }

      animationFrame = requestAnimationFrame(animate);
    };

    const setPaused = (paused: boolean) => {
      isCardActive = paused;
      carousel.toggleAttribute("data-paused", paused);
      if (status) {
        status.textContent = paused
          ? "Carousel paused."
          : "Projects rotate clockwise. Hover or focus a project to pause.";
      }
    };

    items.forEach((item) => {
      item.addEventListener("pointerenter", () => setPaused(true));
      item.addEventListener("pointerleave", () => setPaused(false));
      item.addEventListener("focusin", () => setPaused(true));
      item.addEventListener("focusout", () => setPaused(false));
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry?.isIntersecting ?? true;
        previousTime = performance.now();
      },
      { threshold: 0.05 },
    );

    observer.observe(carousel);
    window.addEventListener("resize", positionItems);
    motionPreference.addEventListener("change", positionItems);
    positionItems();
    animationFrame = requestAnimationFrame(animate);

    document.addEventListener("astro:before-swap", () => {
      cancelAnimationFrame(animationFrame);
      observer.disconnect();
    }, { once: true });
  });
</script>

<style>
  .projects-carousel {
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    color: #121212;
    pointer-events: auto;
  }

  .projects-carousel__header {
    position: absolute;
    inset: clamp(0.9rem, 2vw, 1.5rem) clamp(1rem, 3vw, 2.5rem) auto;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: "Lato", sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .projects-carousel__header p,
  .projects-carousel__intro p,
  .projects-carousel__intro h2,
  .projects-carousel__intro span,
  .project-card h3,
  .projects-carousel__status {
    margin: 0;
  }

  .projects-carousel__stage {
    position: absolute;
    inset: clamp(3.5rem, 7vh, 5rem) clamp(0.75rem, 3vw, 2.5rem) clamp(2rem, 4vh, 3rem);
    min-height: 34rem;
    isolation: isolate;
  }

  .projects-carousel__path {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(72%, 70rem);
    height: 64%;
    translate: -50% -50%;
    border: 1px solid rgba(18, 18, 18, 0.2);
    border-radius: 50%;
  }

  .projects-carousel__intro {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: min(34vw, 24rem);
    translate: -50% -50%;
    text-align: center;
    pointer-events: none;
  }

  .projects-carousel__intro p,
  .projects-carousel__intro span {
    font-family: "Lato", sans-serif;
    font-size: 0.64rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .projects-carousel__intro h2 {
    font-family: "Raleway", sans-serif;
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 650;
    line-height: 0.82;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .projects-carousel__intro span {
    display: block;
    margin-top: 1.25rem;
  }

  .projects-carousel__item {
    --carousel-x: 0px;
    --carousel-y: 0px;
    --carousel-scale: 1;
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(12.5rem, 19vw, 17rem);
    transform: translate3d(
      calc(-50% + var(--carousel-x)),
      calc(-50% + var(--carousel-y)),
      0
    ) scale(var(--carousel-scale));
    transform-origin: center;
    will-change: transform;
  }

  .projects-carousel__item:hover,
  .projects-carousel__item:focus-within {
    z-index: 50 !important;
  }

  .project-card {
    display: block;
    overflow: hidden;
    border: 1px solid #121212;
    border-radius: 0.35rem;
    background: #f3ebe6;
    color: #121212;
    text-decoration: none;
    box-shadow: 0 0.75rem 2rem rgba(18, 18, 18, 0.12);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    transform: scale(1.09);
    box-shadow: 0 1.2rem 3rem rgba(18, 18, 18, 0.2);
    outline: 3px solid var(--project-accent);
    outline-offset: 4px;
  }

  .project-card__image {
    height: clamp(7.5rem, 11vw, 10rem);
    overflow: hidden;
    border-bottom: 0.55rem solid var(--project-accent);
    background: #eee8e4;
  }

  .project-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 550ms ease;
  }

  .project-card__placeholder {
    display: flex;
    height: clamp(7.5rem, 11vw, 10rem);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-bottom: 0.55rem solid var(--project-accent);
    background: color-mix(in srgb, var(--project-accent) 24%, #f3ebe6);
    font-family: "Lato", sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-card__placeholder strong {
    margin-top: 0.35rem;
    font-family: "Raleway", sans-serif;
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    font-weight: 650;
    letter-spacing: 0;
  }

  .project-card:hover .project-card__image img,
  .project-card:focus-visible .project-card__image img {
    transform: scale(1.035);
  }

  .project-card__details {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    min-height: 5.75rem;
    padding: 0.8rem 0.9rem 0.9rem;
  }

  .project-card__number,
  .project-card__meta {
    font-family: "Lato", sans-serif;
    font-size: 0.61rem;
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .project-card h3 {
    max-width: 11ch;
    margin-top: 0.55rem;
    font-family: "Raleway", sans-serif;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    font-weight: 650;
    line-height: 0.95;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .project-card__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    text-align: right;
  }

  .projects-carousel__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .projects-carousel {
      min-height: 42rem;
    }

    .projects-carousel__stage {
      inset: 3.25rem 0.5rem 1rem;
      min-height: 37rem;
    }

    .projects-carousel__path {
      width: 58%;
      height: 68%;
    }

    .projects-carousel__intro {
      width: 38vw;
    }

    .projects-carousel__intro h2 {
      font-size: clamp(2.15rem, 12vw, 3.5rem);
    }

    .projects-carousel__intro span {
      margin-top: 0.75rem;
      font-size: 0.52rem;
    }

    .projects-carousel__item {
      width: min(48vw, 13rem);
    }

    .project-card__image {
      height: 7rem;
    }

    .project-card__placeholder {
      height: 7rem;
    }

    .project-card__details {
      display: block;
      min-height: 5.5rem;
      padding: 0.7rem;
    }

    .project-card__meta {
      display: none;
    }

    .project-card h3 {
      margin-top: 0.4rem;
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__image img {
      transition: none;
    }
  }
</style>
