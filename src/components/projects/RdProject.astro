---
import Footer from "../Footer.astro";

const projectData = {
  id: "rd",
  title: "Resistance Diary",
  description:
    "A training tracker built for progressive overload. No backend, no accounts, no tracking — just a training log that stays out of your way.",
  year: "2025",
  role: "UX/UI Design, Front-End Development",
  type: "Progressive Web App (PWA)",
  technologies: [
    "React 19",
    "TypeScript",
    "Zustand",
    "TanStack Router",
    "Tailwind CSS v4",
    "Framer Motion",
    "Radix UI",
    "Zod",
    "Vite 7",
  ],
  images: [
    {
      src: "/portfolio/images/design/rd-homepage.png",
      alt: "Dashboard Overview",
    },
    {
      src: "/portfolio/images/design/rd-workout-details.png",
      alt: "Workout Details",
    },
    {
      src: "/portfolio/images/design/rd-training-flow.png",
      alt: "Training Flow",
    },
  ],
  liveUrl: "https://fr1endly.github.io/resistance-diary/",
  githubUrl: "https://github.com/Fr1endly/resistance-diary",
};
---

<section
  class="relative w-full min-h-screen bg-stone-900 pt-8 pb-16 px-4 md:px-6"
>
  <!-- Decorative Corner -->
  <div
    class="absolute w-10 h-10 -left-10 top-0 border-white border-t-4 border-l-4 rounded-sm"
  >
  </div>

  <div class="max-w-5xl mx-auto">
    <!-- Header Section -->
    <div class="mb-16 md:mb-24">
      <div class="flex items-center gap-3 mb-6">
        <span
          class="inline-block px-3 py-1 border border-yellow-600 text-yellow-400 text-xs font-lato uppercase tracking-widest"
        >
          {projectData.id}
        </span>
        <span
          class="inline-block px-3 py-1 border border-stone-600 text-stone-400 text-xs font-lato uppercase tracking-widest"
        >
          {projectData.type}
        </span>
      </div>

      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-light text-stone-100 font-raleway mb-6 leading-tight"
      >
        {projectData.title}
      </h1>

      <p
        class="text-stone-300 font-lato text-lg md:text-xl leading-relaxed max-w-3xl"
      >
        {projectData.description}
      </p>
    </div>

    <!-- Info Grid -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20 pb-20 border-b border-stone-800"
    >
      <div>
        <h3
          class="text-stone-400 text-xs font-lato uppercase tracking-widest mb-2"
        >
          Year
        </h3>
        <p class="text-stone-100 text-2xl font-raleway font-light">
          {projectData.year}
        </p>
      </div>

      <div>
        <h3
          class="text-stone-400 text-xs font-lato uppercase tracking-widest mb-2"
        >
          Role
        </h3>
        <p class="text-stone-100 text-lg font-raleway font-light">
          {projectData.role}
        </p>
      </div>

      <div>
        <h3
          class="text-stone-400 text-xs font-lato uppercase tracking-widest mb-2"
        >
          Technologies
        </h3>
        <div class="flex flex-wrap gap-2">
          {
            projectData.technologies.map((tech) => (
              <span class="text-stone-300 text-sm font-lato">{tech}</span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Image Gallery -->
    <div class="mb-20">
      <h2
        class="text-2xl md:text-3xl font-raleway font-light text-stone-100 mb-8"
      >
        Project Gallery
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          projectData.images.map((image) => (
            <div class="relative">
              <img
                src={image.src}
                alt={image.alt}
                class="w-full h-120 object-contain hover:scale-105 transition-transform duration-500"
              />
            </div>
          ))
        }
      </div>
    </div>

    <!-- The Problem -->
    <div class="mb-20">
      <h2
        class="text-2xl md:text-3xl font-raleway font-light text-stone-100 mb-6"
      >
        The Problem
      </h2>
      <p class="text-stone-300 font-lato text-lg leading-relaxed max-w-3xl">
        Most fitness apps try to be everything at once — social network, meal
        planner, step counter, meditation guide. For someone who just wants to
        show up at the gym, log their sets, and see if they're getting stronger,
        the experience is buried under noise. I wanted something focused. A tool
        that does one thing well: track resistance training with progressive
        overload at its core.
      </p>
    </div>

    <!-- Design Direction -->
    <div class="mb-20">
      <h2
        class="text-2xl md:text-3xl font-raleway font-light text-stone-100 mb-8"
      >
        Design Direction
      </h2>

      <div class="space-y-10">
        <div>
          <h3 class="text-xl font-raleway font-light text-stone-100 mb-3">
            Dark Glass Morphism
          </h3>
          <p class="text-stone-300 font-lato leading-relaxed max-w-3xl">
            The app lives in a dark-themed environment with frosted glass
            surfaces. Training happens in gyms — bright, airy interfaces feel
            out of place. The glass cards with subtle backdrop-blur and
            translucent borders create depth without adding visual clutter. The
            dark background recedes; the content floats.
          </p>
        </div>

        <div>
          <h3 class="text-xl font-raleway font-light text-stone-100 mb-3">
            Typography Pairing
          </h3>
          <p class="text-stone-300 font-lato leading-relaxed max-w-3xl">
            Work Sans for headings — clean, geometric, easy to scan across the
            room. Fira Code for numbers — reps, weights, volume. Monospace
            digits align vertically, making it effortless to compare values at a
            glance. This isn't decoration; it's functional.
          </p>
        </div>

        <div>
          <h3 class="text-xl font-raleway font-light text-stone-100 mb-3">
            Amber Accent
          </h3>
          <p class="text-stone-300 font-lato leading-relaxed max-w-3xl">
            A single accent color handles all interactive cues — active states,
            progress indicators, call-to-action buttons. One color means zero
            ambiguity about what's tappable and what's informational.
          </p>
        </div>
      </div>
    </div>

    <!-- Technical Highlights -->
    <div class="mb-20">
      <h2
        class="text-2xl md:text-3xl font-raleway font-light text-stone-100 mb-8"
      >
        Technical Highlights
      </h2>

      <ul class="space-y-4">
        <li class="flex items-start gap-4">
          <span class="text-yellow-600 text-xl mt-1 flex-shrink-0">→</span>
          <span class="text-stone-300 font-lato text-lg">
            <strong class="text-stone-100">Offline-first architecture.</strong> The
            entire app runs as a PWA with Workbox service workers. All data lives
            in localStorage via Zustand's persistence middleware. No backend, no login,
            no loading spinners waiting on a network.
          </span>
        </li>
        <li class="flex items-start gap-4">
          <span class="text-yellow-600 text-xl mt-1 flex-shrink-0">→</span>
          <span class="text-stone-300 font-lato text-lg">
            <strong class="text-stone-100">State architecture.</strong> A single Zustand
            store composed of six domain slices — muscles, exercises, workouts, sessions,
            settings, and UI. Each slice owns its data and actions. The persistence
            layer serializes dates to ISO strings on write and rehydrates them on
            read.
          </span>
        </li>
        <li class="flex items-start gap-4">
          <span class="text-yellow-600 text-xl mt-1 flex-shrink-0">→</span>
          <span class="text-stone-300 font-lato text-lg">
            <strong class="text-stone-100">Session recovery.</strong> If the app closes
            mid-workout — phone dies, browser crashes — the active session persists.
            Reopen the app, tap "Continue Session," pick up exactly where you left
            off.
          </span>
        </li>
      </ul>
    </div>

    <!-- Stack Summary -->
    <div class="mb-20">
      <h2
        class="text-2xl md:text-3xl font-raleway font-light text-stone-100 mb-8"
      >
        Stack Summary
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-4">
        {
          [
            { layer: "Framework", choice: "React 19 + TypeScript" },
            { layer: "Routing", choice: "TanStack Router (file-based)" },
            { layer: "State", choice: "Zustand with persisted slices" },
            { layer: "Styling", choice: "Tailwind CSS v4 + CVA" },
            { layer: "Animation", choice: "Framer Motion" },
            { layer: "Forms", choice: "React Hook Form + Zod" },
            { layer: "Components", choice: "Radix UI primitives" },
            { layer: "Icons", choice: "Lucide" },
            { layer: "Build", choice: "Vite 7" },
            { layer: "Deployment", choice: "PWA (offline-capable)" },
            { layer: "Testing", choice: "Vitest + Testing Library" },
          ].map((row) => (
            <div class="flex items-baseline gap-3 py-2 border-b border-stone-800">
              <span class="text-stone-400 text-sm font-lato uppercase tracking-widest w-28 flex-shrink-0">
                {row.layer}
              </span>
              <span class="text-stone-200 font-lato">{row.choice}</span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Links Section -->
    <div
      class="flex flex-col sm:flex-row gap-6 items-start sm:items-center mb-12"
    >
      <div>
        <h3
          class="text-stone-400 text-xs font-lato uppercase tracking-widest mb-4"
        >
          Links
        </h3>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={projectData.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-2 border border-yellow-600 text-yellow-400 text-sm font-lato uppercase tracking-wider hover:bg-yellow-600/10 transition-colors duration-300"
          >
            Live Site
          </a>
          <a
            href={projectData.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-2 border border-yellow-600 text-yellow-400 text-sm font-lato uppercase tracking-wider hover:bg-yellow-600/10 transition-colors duration-300"
          >
            View Code
          </a>
          <a
            href="/portfolio/"
            class="px-6 py-2 border border-stone-500 text-stone-300 text-sm font-lato uppercase tracking-wider hover:bg-stone-800 transition-colors duration-300"
          >
            ← Back to Home
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <Footer />
</section>
