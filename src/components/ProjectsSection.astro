        <span>work</span>
      </div>

      {
        projects.map((project, index) => (
          <button
            type="button"
            class="project-tab"
            style={`--tab-accent: ${project.accent}`}
            id={`project-tab-${project.id}`}
            role="tab"
            aria-controls={`project-panel-${project.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-project-tab={project.id}
          >
            <span class="tab-number">{project.number}</span>
            <span class="tab-title">{project.shortTitle}</span>
            <span class="tab-arrow" aria-hidden="true">&#8599;</span>
          </button>
        ))
      }

      <a class="rail-contact" href="mailto:gizatulinso@gmail.com">
