<script>
  document.querySelectorAll<HTMLElement>("[data-project-switcher]").forEach((switcher) => {
    const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>("[data-project-tab]"));
    const panels = Array.from(switcher.querySelectorAll<HTMLElement>("[data-project-panel]"));

    const activateProject = (projectId: string, focus = false) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.projectTab === projectId;
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive && focus) tab.focus();
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.projectPanel !== projectId;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        if (tab.dataset.projectTab) activateProject(tab.dataset.projectTab);
      });

      tab.addEventListener("keydown", (event) => {
        if (!["ArrowDown", "ArrowUp", "ArrowRight", "ArrowLeft", "Home", "End"].includes(event.key)) return;

        event.preventDefault();
        let nextIndex = index;
        if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else if (event.key === "ArrowDown" || event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        else nextIndex = (index - 1 + tabs.length) % tabs.length;

        const nextProject = tabs[nextIndex]?.dataset.projectTab;
        if (nextProject) activateProject(nextProject, true);
      });
    });
  });
</script>

<style>
  .project-showcase {
    --ink: #121212;
    --paper: #f2e9e3;
    position: relative;
    width: 100%;
    min-height: 100svh;
    padding: clamp(0.55rem, 1.2vw, 1rem);
    color: var(--ink);
    pointer-events: auto;
  }

  .project-shell {
    display: grid;
    grid-template-columns: clamp(5.5rem, 8.5vw, 7.25rem) minmax(0, 1fr);
    gap: clamp(0.55rem, 1vw, 0.85rem);
    min-height: calc(100svh - clamp(1.1rem, 2.4vw, 2rem));
  }

  .project-rail {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.55rem;
  }

  .rail-heading {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 5.25rem;
    padding: 0.65rem 0.55rem;
    font: 700 0.65rem/1.1 var(--font-family-lato);
    text-transform: uppercase;
  }

  .project-tab {
    position: relative;
    display: flex;
    flex: 0 1 9.2rem;
    flex-direction: column;
    align-items: flex-start;
    min-height: 7rem;
    padding: 0.65rem;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--tab-accent) 26%, var(--paper));
    color: var(--ink);
    text-align: left;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .project-tab:hover,
  .project-tab[aria-selected="true"] {
    background: var(--tab-accent);
  }

  .project-tab:hover {
    transform: translateX(0.15rem);
  }

  .project-tab:focus-visible,
  .case-link:focus-visible,
  .project-stage:focus-visible,
  .rail-contact:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }

  .tab-number,
  .tab-title,
  .tab-arrow {
    position: relative;
    z-index: 1;
  }

  .tab-number {
    font: 700 0.66rem/1 var(--font-family-lato);
  }

  .tab-title {
    margin-top: auto;
    font: 700 clamp(0.72rem, 1vw, 0.92rem)/1.05 var(--font-family-lato);
  }

  .tab-arrow {
    position: absolute;
    top: 0.55rem;
    right: 0.6rem;
    font-size: 0.95rem;
  }

  .rail-contact {
    display: flex;
    justify-content: space-between;
    gap: 0.25rem;
    margin-top: auto;
    padding: 0.75rem 0.55rem;
    border-radius: 0.35rem;
    color: var(--ink);
    font: 700 0.62rem/1.15 var(--font-family-lato);
    text-decoration: none;
  }

  .project-content,
  .project-panel {
    min-width: 0;
    min-height: 0;
  }

  .project-panel {
    display: grid;
    grid-template-columns: minmax(18rem, 0.78fr) minmax(28rem, 1.35fr);
    gap: clamp(0.7rem, 1.4vw, 1.15rem);
    height: 100%;
    padding: clamp(0.75rem, 1.4vw, 1.15rem);
  }

  .project-panel[hidden] {
    display: none;
  }

  .project-copy {
    border: 1px solid var(--ink);
    border-radius: clamp(1rem, 2.4vw, 1.8rem);
    display: flex;
    flex-direction: column;
    padding: clamp(1rem, 2.2vw, 2rem);
    background: color-mix(in srgb, var(--paper) 92%, white);
  }

  .copy-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font: 700 0.66rem/1 var(--font-family-lato);
    text-transform: uppercase;
  }

  .copy-body {
    margin-block: auto;
  }

  .project-type {
    display: inline-block;
    margin: 0 0 1rem;
    padding: 0;
    font: 400 0.72rem/1 var(--font-family-lato);
    text-transform: uppercase;
  }

  .project-copy h2 {
    max-width: 10ch;
    margin: 0;
    font: 650 clamp(2.65rem, 4vw, 4.2rem)/0.88 var(--font-family-raleway);
    letter-spacing: 0;
    text-transform: uppercase;
    overflow-wrap: break-word;
  }

  .project-description {
    max-width: 36rem;
    margin: clamp(1.25rem, 2.2vw, 2rem) 0 0;
    font: 400 clamp(0.9rem, 1.15vw, 1.05rem)/1.45 var(--font-family-lato);
  }

  .project-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(1.35rem, 2.5vw, 2.2rem) 0 0;
    padding-top: 1rem;
  }

  .project-meta div:last-child {
    grid-column: 1 / -1;
  }

  .project-meta dt {
    margin-bottom: 0.3rem;
    font: 700 0.62rem/1 var(--font-family-lato);
    text-transform: uppercase;
  }

  .project-meta dd {
    margin: 0;
    font: 400 0.78rem/1.25 var(--font-family-lato);
  }

  .case-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: fit-content;
    min-width: 10.75rem;
    margin-top: 1.5rem;
    padding: 0.35rem 0;
    color: var(--ink);
    font: 700 0.74rem/1 var(--font-family-lato);
    text-decoration: underline;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.3em;
    transition: transform 180ms ease;
  }

  .case-link:hover {
    transform: translateY(-0.18rem);
  }

  .project-stage {
    position: relative;
    display: block;
    min-height: 30rem;
    overflow: hidden;
    color: var(--ink);
  }

  .project-stage::before,
  .project-stage::after {
    position: absolute;
    z-index: 1;
    width: 18%;
    height: 15%;
    content: "";
    border-block: 1px solid var(--ink);
  }

  .project-stage::before {
    top: 17%;
    left: 0;
    background: var(--project-accent);
  }

  .project-stage::after {
    right: 0;
    bottom: 17%;
    background: var(--project-secondary);
  }

  .stage-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.18;
    vector-effect: non-scaling-stroke;
  }

  .depth-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid var(--ink);
    transform: translate(-50%, -50%);
  }

  .depth-frame--one {
    width: 72%;
    height: 66%;
  }

  .depth-frame--two {
    width: 48%;
    height: 43%;
  }

  .depth-frame--three {
    width: 24%;
    height: 24%;
  }

  .stage-shot {
    position: absolute;
    z-index: 2;
    overflow: hidden;
    border: 1px solid var(--ink);
    background: #fff;
    transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .stage-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage-shot--top {
    top: 0;
    left: 50%;
    width: 25%;
    height: 16%;
    transform: translateX(-50%);
  }

  .stage-shot--top img {
    object-position: top center;
  }

  .stage-shot--left {
    top: 47%;
    left: 0;
    width: 18%;
    height: 34%;
    transform: translateY(-50%);
  }

  .stage-shot--left img {
    object-position: top center;
  }

  .stage-shot--right {
    top: 46%;
    right: 0;
    width: 18%;
    height: 34%;
    transform: translateY(-50%);
  }

  .stage-shot--right img {
    object-position: center;
  }

  .stage-shot--bottom {
    bottom: 0;
    left: 50%;
    width: 25%;
    height: 16%;
    transform: translateX(-50%);
  }

  .stage-shot--bottom img {
    object-position: center 80%;
  }

  .project-stage:hover .stage-shot--top {
    transform: translate(-50%, 0.4rem);
  }

  .project-stage:hover .stage-shot--left {
    transform: translate(0.4rem, -50%);
  }

  .project-stage:hover .stage-shot--right {
    transform: translate(-0.4rem, -50%);
  }

  .project-stage:hover .stage-shot--bottom {
    transform: translate(-50%, -0.4rem);
  }

  .stage-core {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    display: grid;
    width: 22%;
    height: 21%;
    min-width: 7.5rem;
    min-height: 5rem;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--ink);
    background: #fff;
    transform: translate(-50%, -50%);
  }

  .stage-core::after {
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    content: "";
    background: linear-gradient(transparent, rgb(0 0 0 / 0.72));
  }

  .stage-core img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 400ms ease;
  }

  .stage-core span {
    position: absolute;
    z-index: 2;
    bottom: 0.62rem;
    padding: 0.38rem 0.62rem;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font: 700 0.58rem/1 var(--font-family-lato);
    text-transform: uppercase;
  }

  .project-stage:hover .stage-core img {
    transform: scale(1.08);
  }

  @media (max-width: 1050px) {
    .project-panel {
      grid-template-columns: minmax(17rem, 0.9fr) minmax(23rem, 1.1fr);
    }

    .project-copy h2 {
      font-size: clamp(2.4rem, 4.6vw, 3.8rem);
    }
  }

  @media (max-width: 800px) {
    .project-showcase {
      min-height: auto;
      padding: 0.5rem;
    }

    .project-shell {
      display: block;
      min-height: auto;
      overflow: visible;
    }

    .project-rail {
      display: grid;
      grid-template-columns: auto repeat(2, minmax(0, 1fr));
      gap: 0.35rem;
      padding: 0.45rem;
    }

    .rail-heading {
      min-height: 4.5rem;
      padding: 0.5rem;
    }

    .project-tab {
      min-height: 4.5rem;
      padding: 0.55rem;
    }

    .tab-title {
      max-width: 10ch;
    }

    .rail-contact {
      display: none;
    }

    .project-panel {
      grid-template-columns: 1fr;
      height: auto;
      padding: 0.5rem;
    }

    .project-copy {
      min-height: min(35rem, 68svh);
      padding: 1.15rem;
      border-radius: 1rem;
    }

    .project-copy h2 {
      max-width: 11ch;
      font-size: clamp(2.65rem, 11vw, 4.8rem);
    }

    .project-stage {
      min-height: min(72svw, 31rem);
    }
  }

  @media (max-width: 480px) {
    .project-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rail-heading {
      display: none;
    }

    .project-tab {
      min-height: 5.2rem;
    }

    .copy-topline {
      font-size: 0.58rem;
    }

    .project-copy {
      min-height: 36rem;
    }

    .project-stage {
      min-height: 27rem;
    }

    .stage-shot--left,
    .stage-shot--right {
      width: 22%;
    }

    .stage-shot--top,
    .stage-shot--bottom {
      width: 32%;
    }

    .stage-core {
      width: 34%;
      height: 23%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-tab,
    .case-link,
    .stage-shot,
    .stage-core img {
      transition: none;
    }
  }
</style>
