---
import Footer from "../Footer.astro";

const projectData = {
  id: "inspirit-lactation",
  title: "Inspirit Lactation",
  description:
    "A calm, approachable website for an IBCLC practice, bringing services, prenatal classes, evidence-based resources, and appointment booking into one clear experience.",
  year: "2026",
  role: "UX/UI Design, Front-End Development",
  type: "Healthcare Services Website",
  technologies: [
    "Astro",
    "Tailwind CSS",
    "Stripe",
    "Cal.com",
    "Responsive Design",
    "CSS Animation",
  ],
  image: {
    src: "/images/design/mary-see-homepage-full.png",
    alt: "Full homepage of the Inspirit Lactation website",
  },
  liveUrl: "https://www.maryseeibclc.com/",
};

const stack = [
  { layer: "Framework", choice: "Astro" },
  { layer: "Styling", choice: "Tailwind CSS" },
  { layer: "Scheduling", choice: "Cal.com" },
  { layer: "Payments", choice: "Stripe" },
  { layer: "Typography", choice: "Cormorant Garamond + Jost" },
  { layer: "Motion", choice: "CSS transitions + Intersection Observer" },
  { layer: "Rendering", choice: "Static site generation" },
];
---

<section
  class="case-study relative w-full min-h-screen pt-8 px-4 md:px-6"
  data-project="inspirit-lactation"
>
  <div class="max-w-5xl mx-auto">
    <header class="mb-16 md:mb-24">
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="case-study__tag case-study__tag--accent type-label inline-block px-3 py-1 border">
          {projectData.id}
        </span>
        <span class="case-study__tag type-label inline-block px-3 py-1 border">
          {projectData.type}
        </span>
      </div>

      <h1 class="type-display text-stone-100 mb-6">{projectData.title}</h1>
      <p class="type-lede text-stone-300 max-w-3xl">{projectData.description}</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20 pb-20 border-b border-stone-800">
      <div>
        <h2 class="type-label text-stone-400 mb-2">Year</h2>
        <p class="type-data text-stone-100 text-2xl">{projectData.year}</p>
      </div>
      <div>
        <h2 class="type-label text-stone-400 mb-2">Role</h2>
        <p class="type-data text-stone-100">{projectData.role}</p>
      </div>
      <div>
        <h2 class="type-label text-stone-400 mb-2">Technologies</h2>
        <div class="flex flex-wrap gap-2">
          {projectData.technologies.map((tech) => <span class="type-meta text-stone-300">{tech}</span>)}
        </div>
      </div>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-8">Project Gallery</h2>
      <div class="case-study__media relative">
        <img src={projectData.image.src} alt={projectData.image.alt} class="block w-full h-auto" />
      </div>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-6">The Goal</h2>
      <p class="type-body-lg text-stone-300 max-w-3xl">
        Families looking for feeding support are often navigating a stressful,
        time-sensitive moment. The site needed to quickly establish trust,
        explain the available support, and provide a clear path from learning
        about the practice to booking an appointment.
      </p>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-8">Design Direction</h2>
      <div class="space-y-10">
        <div>
          <h3 class="type-subheading text-stone-100 mb-3">Calm and Reassuring</h3>
          <p class="type-body text-stone-300 max-w-3xl">
            Soft neutral surfaces, warm photography, and restrained sage and
            blush accents create a supportive tone without making the interface
            feel overly clinical.
          </p>
        </div>
        <div>
          <h3 class="type-subheading text-stone-100 mb-3">Editorial Typography</h3>
          <p class="type-body text-stone-300 max-w-3xl">
            Cormorant Garamond gives headings a personal, established character,
            while Jost keeps navigation, service details, and calls to action
            clear at every screen size.
          </p>
        </div>
        <div>
          <h3 class="type-subheading text-stone-100 mb-3">Guided Next Steps</h3>
          <p class="type-body text-stone-300 max-w-3xl">
            Services, classes, resources, and booking are separated into direct
            pathways so visitors can act without searching through dense
            informational content.
          </p>
        </div>
      </div>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-8">Technical Highlights</h2>
      <ul class="space-y-4">
        <li class="flex items-start gap-4">
          <span class="case-study__bullet text-xl mt-1 flex-shrink-0">→</span>
          <span class="type-body-lg text-stone-300">
            <strong class="text-stone-100">Static-first architecture.</strong>
            Astro delivers pre-rendered pages with a small client-side footprint
            for quick access on mobile connections.
          </span>
        </li>
        <li class="flex items-start gap-4">
          <span class="case-study__bullet text-xl mt-1 flex-shrink-0">→</span>
          <span class="type-body-lg text-stone-300">
            <strong class="text-stone-100">Scheduling and payments.</strong>
            Cal.com provides the appointment-scheduling flow, while Stripe
            handles online payments as part of the booking experience.
          </span>
        </li>
        <li class="flex items-start gap-4">
          <span class="case-study__bullet text-xl mt-1 flex-shrink-0">→</span>
          <span class="type-body-lg text-stone-300">
            <strong class="text-stone-100">Responsive service navigation.</strong>
            A compact mobile menu and fluid content grids keep the main booking
            and resource paths accessible across screen sizes.
          </span>
        </li>
        <li class="flex items-start gap-4">
          <span class="case-study__bullet text-xl mt-1 flex-shrink-0">→</span>
          <span class="type-body-lg text-stone-300">
            <strong class="text-stone-100">Progressive content reveals.</strong>
            Intersection Observer activates lightweight section transitions as
            content enters the viewport.
          </span>
        </li>
      </ul>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-8">Stack Summary</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-4">
        {stack.map((row) => (
          <div class="flex items-baseline gap-3 py-2 border-b border-stone-800">
            <span class="type-label text-stone-400 w-28 flex-shrink-0">{row.layer}</span>
            <span class="type-body text-stone-200">{row.choice}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center mb-12">
      <div>
        <h2 class="type-label text-stone-400 mb-4">Links</h2>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={projectData.liveUrl} target="_blank" rel="noopener noreferrer" class="case-study__action case-study__action--primary type-action px-6 py-2 border transition-colors duration-300">
            Live Site
          </a>
          <a href="/" class="case-study__action type-action px-6 py-2 border transition-colors duration-300">
            ← Back to Home
          </a>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</section>
