---
interface Props {
  class?: string;
  as?: 'div' | 'section' | 'article' | 'aside';
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'full';
}

const {
  class: className = '',
  as: Element = 'div',
  maxWidth = 'xl'
} = Astro.props as Props;

const maxWidthClasses: Record<NonNullable<Props['maxWidth']>, string> = {
  sm: 'max-w-screen-sm',
  md: 'max-w-screen-md',
  lg: 'max-w-screen-lg',
  xl: 'max-w-screen-xl',
  '2xl': 'max-w-screen-2xl',
  full: 'max-w-full'
};
---

<Element class={`container mx-auto px-4 sm:px-6 lg:px-8 ${maxWidthClasses[maxWidth]} ${className}`}>
  <slot />
</Element>
