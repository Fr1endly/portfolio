---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Transparent Text Effect - Portfolio"
  description="Creative transparent text effect with animated background"
  keywords="transparent text, knockout effect, portfolio"
>
  <div class="page-wrapper">
    <div class="container">
      <!-- Layer 1: Animated background -->
      <div class="background-layer">
        <div class="circle circle1"></div>
        <div class="circle circle2"></div>
        <div class="circle circle3"></div>
      </div>

      <!-- Layer 2: Black background with transparent text -->
      <div class="text-layer">
        <h1>CALL TO<br />ACTION</h1>
      </div>

      <!-- Alternative knockout method -->
      <div class="knockout-text">
        <h1>CALL TO<br />ACTION</h1>
      </div>

      <div class="controls">
        <button id="toggleBtn">Toggle Method</button>
      </div>
    </div>

    <div class="info">
      <h2>Two Methods Used:</h2>
      <p>
        <strong>Method 1 (Default):</strong> Solid black overlay with mix-blend-mode:
        multiply. White text becomes a transparent window showing the background image.<br
        /><br />
        <strong>Method 2:</strong> Semi-transparent overlay with glowing text effect,
        also using multiply blend mode for the knockout.
      </p>
    </div>
  </div>
</Layout>

<style>
  .page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #f0f0f0;
    padding: 20px;
  }

  .container {
    position: relative;
    width: 600px;
    height: 400px;
    border: 2px solid #ccc;
    isolation: isolate;
    max-width: 100%;
  }

  /* Layer 1 - Background with image */
  .background-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: url('/images/background.jpg');
    background-size: cover;
    background-position: center;
    overflow: hidden;
  }

  .circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.6;
    animation: float 6s ease-in-out infinite;
  }

  .circle1 {
    width: 80px;
    height: 80px;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.3) 2px,
      rgba(255, 255, 255, 0.3) 4px
    );
    border: 3px solid rgba(255, 0, 0, 0.5);
    top: 30%;
    left: 20%;
    animation-delay: 0s;
  }

  .circle2 {
    width: 100px;
    height: 100px;
    background: repeating-linear-gradient(
      -45deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.3) 2px,
      rgba(255, 255, 255, 0.3) 4px
    );
    border: 3px solid rgba(255, 200, 0, 0.5);
    top: 20%;
    left: 45%;
    animation-delay: 2s;
  }

  .circle3 {
    width: 90px;
    height: 90px;
    background: repeating-linear-gradient(
      90deg,
      transparent,
      transparent 2px,
      rgba(255, 255, 255, 0.3) 2px,
      rgba(255, 255, 255, 0.3) 4px
    );
    border: 3px solid rgba(0, 100, 255, 0.5);
    top: 40%;
    left: 35%;
    animation-delay: 4s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(30px, -20px);
    }
    50% {
      transform: translate(-20px, 30px);
    }
    75% {
      transform: translate(40px, 10px);
    }
  }

  /* Layer 2 - Black overlay with transparent text (knockout effect) */
  .text-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #000;
    display: flex;
    justify-content: center;
    align-items: center;
    mix-blend-mode: multiply;
  }

  .text-layer h1 {
    font-family: 'Arial Black', sans-serif;
    font-size: 72px;
    font-weight: 900;
    color: #fff;
    text-align: center;
    letter-spacing: 2px;
    line-height: 1.2;
  }

  /* Alternative method - Semi-transparent overlay with knockout text */
  .knockout-text {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    mix-blend-mode: multiply;
  }

  .knockout-text h1 {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: 'Arial Black', sans-serif;
    font-size: 72px;
    font-weight: 900;
    text-align: center;
    letter-spacing: 2px;
    color: #fff;
    text-shadow:
      0 0 30px rgba(255, 255, 255, 0.5),
      0 0 60px rgba(255, 255, 255, 0.3);
    line-height: 1.2;
  }

  .controls {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
  }

  button {
    padding: 10px 20px;
    font-size: 14px;
    background: #fff;
    border: 2px solid #333;
    border-radius: 5px;
    cursor: pointer;
    margin: 0 5px;
    font-weight: bold;
    transition: all 0.3s ease;
  }

  button:hover {
    background: #333;
    color: #fff;
  }

  .info {
    margin-top: 30px;
    text-align: center;
    max-width: 600px;
  }

  .info h2 {
    margin-bottom: 10px;
    color: #333;
    font-size: 24px;
  }

  .info p {
    color: #666;
    line-height: 1.6;
    font-size: 16px;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .container {
      width: 100%;
      height: 300px;
    }

    .text-layer h1,
    .knockout-text h1 {
      font-size: 48px;
    }

    .circle1,
    .circle2,
    .circle3 {
      width: 60px;
      height: 60px;
    }
  }
</style>

<script>
  let currentMethod = 1;

  function toggleMethod() {
    const textLayer = document.querySelector('.text-layer');
    const knockoutText = document.querySelector('.knockout-text');

    if (currentMethod === 1) {
      textLayer!.style.display = 'none';
      knockoutText!.style.display = 'block';
      currentMethod = 2;
    } else {
      textLayer!.style.display = 'flex';
      knockoutText!.style.display = 'none';
      currentMethod = 1;
    }
  }

  const toggleBtn = document.getElementById('toggleBtn');
  toggleBtn?.addEventListener('click', toggleMethod);
</script>
