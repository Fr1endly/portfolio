---
import Footer from "../Footer.astro";
---

<section class="relative w-full min-h-screen bg-stone-900 pt-8 pb-16 px-4 md:px-6 flex flex-col justify-between">
  <div class="flex-1 flex items-center justify-center">
    <div class="text-center max-w-md mx-auto">
      <!-- 404 Display -->
      <div class="mb-8">
        <h1 class="text-8xl md:text-9xl font-light text-stone-700 font-raleway mb-4">
          404
        </h1>
        <h2 class="text-3xl md:text-4xl font-light text-stone-100 font-raleway mb-6">
          Project Not Found
        </h2>
        <p class="text-stone-400 font-lato mb-8 leading-relaxed">
          The project you're looking for doesn't exist. Let's get you back on track.
        </p>
      </div>

      <!-- Back Link -->
      <a
        href="/portfolio/"
        class="inline-block px-6 py-3 border border-stone-400 text-stone-100 font-lato uppercase tracking-wider text-sm hover:bg-stone-800 transition-colors duration-300"
      >
        Back to Home
      </a>
    </div>
  </div>

  <!-- Footer -->
  <Footer />
</section>
