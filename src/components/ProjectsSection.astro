                  </div>
                </dl>
              </div>

              <a class="case-link" href={`/projects/${project.id}`}>
                <span>View case study</span>
                <span aria-hidden="true">&#8599;</span>
              </a>
            </div>

            <!-- <a
              class="project-stage"
