---
const projects = [
  {
    id: "sbs",
    number: "01",
    title: "Side by Side",
    shortTitle: "Side by Side",
    type: "Web experience",
    year: "2024",
    role: "UX/UI + development",
    stack: "Next.js / React / GSAP",
    description:
      "A digital home for a Latvia-made tabletop RPG, designed to introduce the world through atmosphere, movement, and interactive play examples.",
    tabBackground: "bg-[color-mix(in_srgb,#2f6edb_26%,#f2e9e3)] hover:bg-[#2f6edb] aria-selected:bg-[#2f6edb]",
  },
  {
    id: "rd",
    number: "02",
    title: "Resistance Diary",
    shortTitle: "Resistance Diary",
    type: "Progressive web app",
    year: "2025",
    role: "Product design + development",
    stack: "React / TypeScript / Zustand",
    description:
      "An offline-first training tracker focused on progressive overload: no accounts, no distractions, just a fast record of the work that matters.",
    tabBackground: "bg-[color-mix(in_srgb,#ffad27_26%,#f2e9e3)] hover:bg-[#ffad27] aria-selected:bg-[#ffad27]",
  },
];
---

<section id="projects" class="border-2 border-red-500 relative w-full min-h-svh p-[clamp(0.55rem,1.2vw,1rem)] text-[#121212] pointer-events-auto max-[800px]:min-h-0 max-[800px]:p-2" aria-label="Selected projects">
  <div class="grid grid-cols-[clamp(5.5rem,8.5vw,7.25rem)_minmax(0,1fr)] gap-[clamp(0.55rem,1vw,0.85rem)] min-h-[calc(100svh-clamp(1.1rem,2.4vw,2rem))] max-[800px]:block max-[800px]:min-h-0" data-project-switcher>
    <div class="flex flex-col gap-[0.45rem] p-[0.55rem] max-[800px]:grid max-[800px]:grid-cols-[auto_repeat(2,minmax(0,1fr))] max-[800px]:gap-[0.35rem] max-[800px]:p-[0.45rem] max-[480px]:grid-cols-2" role="tablist" aria-label="Selected projects">
      <div class="flex flex-col justify-between min-h-[5.25rem] px-[0.55rem] py-[0.65rem] font-lato text-[0.65rem] leading-[1.1] font-bold uppercase max-[800px]:min-h-[4.5rem] max-[800px]:p-2 max-[480px]:hidden" aria-hidden="true">
        <span>Selected</span>
        <span>work</span>
      </div>

      {
        projects.map((project, index) => (
          <button
            type="button"
            class={`relative flex flex-[0_1_9.2rem] flex-col items-start min-h-28 p-[0.65rem] overflow-hidden border border-transparent rounded-[0.35rem] text-left cursor-pointer transition-[background-color,color,transform] duration-180 ease-in-out hover:translate-x-[0.15rem] focus-visible:outline-3 focus-visible:outline-[#121212] focus-visible:outline-offset-2 motion-reduce:transition-none max-[800px]:min-h-[4.5rem] max-[800px]:p-[0.55rem] max-[480px]:min-h-[5.2rem] ${project.tabBackground}`}
            id={`project-tab-${project.id}`}
            role="tab"
            aria-controls={`project-panel-${project.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-project-tab={project.id}
          >
            <span class="relative z-[1] font-lato text-[0.66rem] leading-none font-bold">{project.number}</span>
            <span class="relative z-[1] mt-auto font-lato text-[clamp(0.72rem,1vw,0.92rem)] leading-[1.05] font-bold max-[800px]:max-w-[10ch]">{project.shortTitle}</span>
            <span class="absolute top-[0.55rem] right-[0.6rem] z-[1] text-[0.95rem]" aria-hidden="true">&#8599;</span>
          </button>
        ))
      }

      <a class="mt-auto flex justify-between gap-1 rounded-[0.35rem] px-[0.55rem] py-3 font-lato text-[0.62rem] leading-[1.15] font-bold text-[#121212] no-underline focus-visible:outline-3 focus-visible:outline-[#121212] focus-visible:outline-offset-2 max-[800px]:hidden" href="mailto:gizatulinso@gmail.com">
        <span>Available for work</span>
        <span aria-hidden="true">&#8599;</span>
      </a>
    </div>

    <div class="min-w-0 min-h-0">
      {
        projects.map((project, index) => (
          <article
            class="grid grid-cols-[minmax(18rem,0.78fr)_minmax(28rem,1.35fr)] gap-[clamp(0.7rem,1.4vw,1.15rem)] h-full min-w-0 min-h-0 p-[clamp(0.75rem,1.4vw,1.15rem)] max-[1050px]:grid-cols-[minmax(17rem,0.9fr)_minmax(23rem,1.1fr)] max-[800px]:grid-cols-1 max-[800px]:h-auto max-[800px]:p-2"
            id={`project-panel-${project.id}`}
            role="tabpanel"
            aria-labelledby={`project-tab-${project.id}`}
            data-project-panel={project.id}
            hidden={index !== 0}
          >
            <div class="flex flex-col rounded-[clamp(1rem,2.4vw,1.8rem)] border border-[#121212] bg-[#f3ebe6] p-[clamp(1rem,2.2vw,2rem)] max-[800px]:min-h-[min(35rem,68svh)] max-[800px]:rounded-2xl max-[800px]:p-[1.15rem] max-[480px]:min-h-[36rem]">
              <div class="flex justify-between gap-4 font-lato text-[0.66rem] leading-none font-bold uppercase max-[480px]:text-[0.58rem]">
                <span>Layer 03 / Projects</span>
                <span>{project.number} of {String(projects.length).padStart(2, "0")}</span>
              </div>

              <div class="my-auto">
                <p class="mb-4 inline-block p-0 font-lato text-[0.72rem] leading-none font-normal uppercase">{project.type}</p>
                <h2 class="m-0 max-w-[10ch] [overflow-wrap:break-word] font-raleway text-[clamp(2.65rem,4vw,4.2rem)] leading-[0.88] font-[650] tracking-normal uppercase max-[1050px]:text-[clamp(2.4rem,4.6vw,3.8rem)] max-[800px]:max-w-[11ch] max-[800px]:text-[clamp(2.65rem,11vw,4.8rem)]">{project.title}</h2>
                <p class="mt-[clamp(1.25rem,2.2vw,2rem)] max-w-xl font-lato text-[clamp(0.9rem,1.15vw,1.05rem)] leading-[1.45] font-normal">{project.description}</p>

                <dl class="mt-[clamp(1.35rem,2.5vw,2.2rem)] grid grid-cols-2 gap-4 pt-4 font-lato [&_dt]:mb-[0.3rem] [&_dt]:text-[0.62rem] [&_dt]:leading-none [&_dt]:font-bold [&_dt]:uppercase [&_dd]:m-0 [&_dd]:text-[0.78rem] [&_dd]:leading-[1.25] [&_dd]:font-normal">
                  <div>
                    <dt>Year</dt>
                    <dd>{project.year}</dd>
                  </div>
                  <div>
                    <dt>Role</dt>
                    <dd>{project.role}</dd>
                  </div>
                  <div class="col-span-2">
                    <dt>Built with</dt>
                    <dd>{project.stack}</dd>
                  </div>
                </dl>
              </div>

              <a class="mt-6 flex w-fit min-w-[10.75rem] items-center justify-between py-[0.35rem] font-lato text-[0.74rem] leading-none font-bold text-[#121212] underline decoration-[0.1em] underline-offset-[0.3em] transition-transform duration-180 hover:-translate-y-[0.18rem] focus-visible:outline-3 focus-visible:outline-[#121212] focus-visible:outline-offset-2 motion-reduce:transition-none" href={`/projects/${project.id}`}>
                <span>View case study</span>
                <span aria-hidden="true">&#8599;</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-switcher]").forEach((switcher) => {
    const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>("[data-project-tab]"));
    const panels = Array.from(switcher.querySelectorAll<HTMLElement>("[data-project-panel]"));

    const activateProject = (projectId: string, focus = false) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.projectTab === projectId;
        tab.setAttribute("aria-selected", String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
        if (isActive && focus) tab.focus();
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.projectPanel !== projectId;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        if (tab.dataset.projectTab) activateProject(tab.dataset.projectTab);
      });

      tab.addEventListener("keydown", (event) => {
        if (!["ArrowDown", "ArrowUp", "ArrowRight", "ArrowLeft", "Home", "End"].includes(event.key)) return;

        event.preventDefault();
        let nextIndex = index;
        if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else if (event.key === "ArrowDown" || event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        else nextIndex = (index - 1 + tabs.length) % tabs.length;

        const nextProject = tabs[nextIndex]?.dataset.projectTab;
        if (nextProject) activateProject(nextProject, true);
      });
    });
  });
</script>
