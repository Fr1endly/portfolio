---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Home - My Portfolio"
  description="Welcome to my portfolio website showcasing my work and projects"
  keywords="portfolio, web development, projects"
>
  <!-- Optional Header -->

  <!-- Main Content -->
  <section
    class="h-screen min-h-screen w-full bg-stone-800 flex flex-col items-center justify-start px-4"
  >
    <div class="h-1/6"></div>
    <div class="text-center">
      <div class="relative">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-8xl text-neutral-50 font-medium italic font-raleway tracking-tight"
        >
          Oscar Gizatulin
        </h1>
        <p
          class="text-lg sm:text-xl text-neutral-50 max-w-2xl mx-auto tracking-wide font-lato"
        >
          Welcome to my portfolio. Explore my work and get in touch.
        </p>
        <img
          src="/images/sticky_notes.png"
          alt="Sticky notes illustration"
          class="mx-auto w-140 absolute right-30 -bottom-58"
        />
        <img
          src="/images/Laptop.png"
          alt="Laptop illustration"
          class="mx-auto w-230 absolute inset-x-0 -bottom-56"
        />
        <img
          src="/images/coffe.png"
          alt="Sticky notes illustration"
          class="mx-auto w-100 absolute left-50 -bottom-56"
        />
      </div>
    </div>
  </section>

  <!-- Optional Footer -->
</Layout>
