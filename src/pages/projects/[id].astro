---
import Layout from "../../layouts/Layout.astro";
import SbsProject from "../../components/projects/SbsProject.astro";
import RdProject from "../../components/projects/RdProject.astro";
import PortfolioProject from "../../components/projects/PortfolioProject.astro";
import InspiritProject from "../../components/projects/InspiritProject.astro";

export function getStaticPaths() {
  return [
    { params: { id: 'sbs' } },
    { params: { id: 'rd' } },
    { params: { id: 'portfolio' } },
    { params: { id: 'inspirit-lactation' } }
  ];
}

const projectComponents = {
  'sbs': SbsProject,
  'rd': RdProject,
  'portfolio': PortfolioProject,
  'inspirit-lactation': InspiritProject
};

const projectMetadata = {
  'sbs': {
    title: 'Side by Side — Tabletop RPG Website - Oscar Gizatulin Portfolio',
    description: 'A promotional website for a Latvia-made tabletop RPG system, featuring interactive gameplay demos, scroll-driven storytelling, and markdown-based content management',
    keywords: 'Side by Side, Tabletop RPG, Next.js, React, Locomotive Scroll, Framer Motion, portfolio'
  },
  'rd': {
    title: 'Resistance Diary - Oscar Gizatulin Portfolio',
    description: 'A progressive overload training tracker PWA built with React 19, TypeScript, Zustand, and Framer Motion',
    keywords: 'Resistance Diary, Training Tracker, PWA, React 19, TypeScript, Zustand, Tailwind CSS, portfolio'
  },
  'portfolio': {
    title: 'Portfolio Website - Oscar Gizatulin',
    description: 'A responsive creative portfolio built with Astro, TypeScript, Tailwind CSS, and a custom animated project carousel',
    keywords: 'Oscar Gizatulin, portfolio website, Astro, TypeScript, Tailwind CSS, front-end development, web design'
  },
  'inspirit-lactation': {
    title: 'Inspirit Lactation Website - Oscar Gizatulin Portfolio',
    description: 'A calm, responsive website for an IBCLC practice with Stripe payments and Cal.com appointment scheduling',
    keywords: 'Inspirit Lactation, IBCLC website, healthcare web design, Astro, Tailwind CSS, Stripe, Cal.com, appointment scheduling, portfolio'
  }
};

const projectId = Astro.params.id as keyof typeof projectComponents;
const ProjectComponent = projectComponents[projectId];
const metadata = projectMetadata[projectId];
---

<Layout
  title={metadata.title}
  description={metadata.description}
  keywords={metadata.keywords}
>
  <ProjectComponent />
</Layout>
