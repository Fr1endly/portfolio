---
interface Props {
  title: string;
  imageUrl: string;
  imageAlt?: string;
  number: string;
  variant?: "white" | "black";
  imageBgColor?: string;
}

const {
  title,
  imageUrl,
  imageAlt = "Project",
  number,
  variant = "white",
  imageBgColor,
} = Astro.props;

const isWhite = variant === "white";
const textColor = "text-stone-100";
const borderColor = isWhite ? "border-pink-600" : "border-yellow-600";
const numberColor = "text-stone-100";
const defaultImageBg = isWhite ? "bg-stone-700" : "bg-stone-900";
const imageBg = imageBgColor || defaultImageBg;
---

<div class={`brightness-90 group relative animated-gradient overflow-hidden border ${borderColor} rounded-md
             transition-all duration-500 hover:shadow-2xl hover:shadow-neutral-900 flex-shrink-0
             w-[85vw] md:w-[45vw] lg:w-[300px] h-100 snap-start`}
   >
  <div class="flex flex-col h-full p-5">
    <h3 class={`text-lg font-light ${textColor} font-lato uppercase tracking-wider leading-tight text-right mb-auto`} set:html={title} />
    <div class="flex items-end justify-between">
      <div class={`w-40 h-40 rounded-xl ${imageBg} overflow-hidden bg-stone-200`}>
        <img src={imageUrl} alt={imageAlt} class="w-full h-full object-center bg-stone-200" />
      </div>
      <span class={`${numberColor} text-sm font-light font-lato`}>{number}</span>
    </div>
  </div>
</div>

<style>
  .animated-gradient {
    background: linear-gradient(135deg, #0ea5e9, #a855f7, #7c3aed, #f97316);
    background-size: 400% 400%;
    animation: gradientCycle 8s ease infinite;
  }

  @keyframes gradientCycle {
    0% {
      background-position: 0% 50%;
    }
    25% {
      background-position: 50% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    75% {
      background-position: 50% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>
