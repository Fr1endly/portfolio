---
const featuredProjects = [
  {
    id: "sbs",
    number: "01",
    title: "Side by Side",
    type: "Web experience",
    year: "2024",
    image: "/images/design/sbs-homepage.png",
    imageAlt: "Side by Side website interface",
    accent: "#2f6edb",
  },
  {
    id: "rd",
    number: "02",
    title: "Resistance Diary",
    type: "Progressive web app",
    year: "2025",
    image: "/images/design/rd-homepage.png",
    imageAlt: "Resistance Diary mobile app interface",
    accent: "#ffad27",
  },
];

const placeholderProjects = Array.from({ length: 1 }, (_, index) => ({
  id: `open-${index + 1}`,
  number: String(index + 3).padStart(2, "0"),
  title: "Place for your project",
  type: "Available slot",
  year: "Let's talk",
  image: null,
  imageAlt: "",
  accent: index % 2 === 0 ? "#2f6edb" : "#ffad27",
}));

const projects = [...featuredProjects, ...placeholderProjects];
---

<section
  id="projects"
  class="projects-carousel "
  aria-labelledby="projects-heading"
  data-project-carousel
>
  <div class="projects-carousel__stage" data-carousel-stage>
    <div class="projects-carousel__intro">
      <p>Selected</p>
      <h2 id="projects-heading">Work</h2>
      <span>2024 / 2026</span>
    </div>

    <div class="projects-carousel__path" aria-hidden="true"></div>

    {
      projects.map((project) => (
        <div
          class="projects-carousel__item"
          data-carousel-item
        >
          <a
            class="project-card"
            href={project.image ? `/projects/${project.id}` : "mailto:gizatulinso@gmail.com?subject=Project%20inquiry"}
            style={`--project-accent: ${project.accent}`}
            aria-label={project.image ? `View ${project.title} case study` : "Get in touch about your project"}
          >
            {
              project.image ? (
                <div class="project-card__image">
                  <img src={project.image} alt={project.imageAlt} loading="lazy" />
                </div>
              ) : (
                <div class="project-card__placeholder" aria-hidden="true">
                  <span>Open</span>
                </div>
              )
            }
            <div class="project-card__details">
              <span class="project-card__number">{project.number}</span>
              <div class="project-card__content">
                <h3>{project.title}</h3>
                <div class="project-card__meta">
                  <span>{project.type}</span>
                  <span>{project.year} &#8599;</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      ))
    }
  </div>

  <p class="projects-carousel__status" aria-live="polite" data-carousel-status>
    Projects rotate clockwise. Hover or focus a project to pause.
  </p>
</section>

<script>
  const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-project-carousel]").forEach((carousel) => {
    const stage = carousel.querySelector<HTMLElement>("[data-carousel-stage]");
    const items = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-item]"));
    const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");

    if (!stage || items.length === 0) return;

    let angle = -Math.PI / 2;
    let previousTime = performance.now();
    let isCardActive = false;
    let isVisible = true;

    const positionItems = () => {
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      const isCompact = width < 700;
      const tilt =
        (Number.parseFloat(
          getComputedStyle(stage).getPropertyValue("--carousel-tilt"),
        ) *
          Math.PI) /
        180;
      const radiusScale =
        Number.parseFloat(
          getComputedStyle(stage).getPropertyValue("--carousel-radius-scale"),
        ) || 1;
      const cardScale =
        Number.parseFloat(
          getComputedStyle(stage).getPropertyValue("--carousel-card-scale"),
        ) || 1;
      const baseRadiusX = Math.max(
        0,
        isCompact ? width * 0.17 : Math.min(width * 0.30, height * 0.4),
      );
      const baseRadiusY = Math.max(
        0,
        isCompact
          ? height * 0.24
          : Math.min(baseRadiusX * (8 / 7), height * 0.24),
      );
      const radiusX = baseRadiusX * radiusScale;
      const radiusY = baseRadiusY * radiusScale;

      stage.style.setProperty("--carousel-radius-x", `${radiusX}px`);
      stage.style.setProperty("--carousel-radius-y", `${radiusY}px`);

      items.forEach((item, index) => {
        const itemAngle = angle + (index / items.length) * Math.PI * 2;
        const ellipseX = Math.cos(itemAngle) * radiusX;
        const ellipseY = Math.sin(itemAngle) * radiusY;
        const x = ellipseX * Math.cos(tilt) - ellipseY * Math.sin(tilt);
        const y = ellipseX * Math.sin(tilt) + ellipseY * Math.cos(tilt);
        const depth = (Math.sin(itemAngle) + 1) / 2;

        item.style.setProperty("--carousel-x", `${x}px`);
        item.style.setProperty("--carousel-y", `${y}px`);
        item.style.setProperty(
          "--carousel-scale",
          String((0.88 + depth * 0.12) * cardScale),
        );
        item.style.zIndex = String(2 + Math.round(depth * 10));
      });
    };

    const animate = (time: number) => {
      const elapsed = Math.min(time - previousTime, 40);
      previousTime = time;

      if (!isCardActive && isVisible && !motionPreference.matches) {
        angle += elapsed * 0.000055;
        positionItems();
      }

      requestAnimationFrame(animate);
    };

    const setPaused = (paused: boolean) => {
      isCardActive = paused;
      if (status) {
        status.textContent = paused
          ? "Carousel paused."
          : "Projects rotate clockwise. Hover or focus a project to pause.";
      }
    };

    items.forEach((item) => {
      item.addEventListener("pointerenter", () => setPaused(true));
      item.addEventListener("pointerleave", () => setPaused(false));
      item.addEventListener("focusin", () => setPaused(true));
      item.addEventListener("focusout", () => setPaused(false));
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry?.isIntersecting ?? true;
        previousTime = performance.now();
      },
      { threshold: 0.05 },
    );

    observer.observe(carousel);
    window.addEventListener("resize", positionItems);
    motionPreference.addEventListener("change", positionItems);
    positionItems();
    requestAnimationFrame(animate);

  });
</script>

<style>
  .projects-carousel {
    position: relative;
    width: 100%;
    min-height: 90svh;
    overflow: visible;
    color: #121212;
    pointer-events: auto;
  }

  .projects-carousel__intro p,
  .projects-carousel__intro h2,
  .projects-carousel__intro span,
  .project-card h3,
  .projects-carousel__status {
    margin: 0;
  }

  .projects-carousel__stage {
    --carousel-center-x: 68%;
    --carousel-center-y: 57%;
    --carousel-radius-x: 18rem;
    --carousel-radius-y: 20rem;
    --carousel-radius-scale: 1.43;
    --carousel-card-scale: 0.8;
    --carousel-tilt: -37deg;
    position: absolute;
    inset: clamp(3.5rem, 7vh, 5rem) clamp(0.75rem, 3vw, 2.5rem) clamp(2rem, 4vh, 3rem);
    min-height: 34rem;
    isolation: isolate;
  }

  .projects-carousel__path {
    position: absolute;
    top: var(--carousel-center-y);
    left: var(--carousel-center-x);
    width: calc(var(--carousel-radius-x) * 2);
    height: calc(var(--carousel-radius-y) * 2);
    translate: -50% -50%;
    rotate: var(--carousel-tilt);
    border: 1px solid rgba(18, 18, 18, 0.2);
    border-radius: 50%;
  }

  .projects-carousel__intro {
    position: absolute;
    top: var(--carousel-center-y);
    left: var(--carousel-center-x);
    z-index: 1;
    width: min(34vw, 24rem);
    translate: -50% -50%;
    text-align: center;
    pointer-events: none;
  }

  .projects-carousel__intro p,
  .projects-carousel__intro span {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .projects-carousel__intro h2 {
    font-family: var(--font-display);
    font-size: 5.5rem;
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .projects-carousel__intro span {
    display: block;
    margin-top: 1.25rem;
  }

  .projects-carousel__item {
    --carousel-x: 0px;
    --carousel-y: 0px;
    --carousel-scale: 1;
    position: absolute;
    top: var(--carousel-center-y);
    left: var(--carousel-center-x);
    width: clamp(12.5rem, 19vw, 17rem);
    transform: translate3d(
      calc(-50% + var(--carousel-x)),
      calc(-50% + var(--carousel-y)),
      0
    ) scale(var(--carousel-scale));
    transform-origin: center;
    will-change: transform;
  }

  .projects-carousel__item:hover,
  .projects-carousel__item:focus-within {
    z-index: 50 !important;
  }

  .project-card {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 0.35rem;
    background: #232323;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 0.75rem 2rem rgba(18, 18, 18, 0.12);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .project-card:hover,
  .project-card:focus-visible {
    transform: scale(1.09);
    box-shadow: 0 1.2rem 3rem rgba(18, 18, 18, 0.2);
    outline: 3px solid var(--project-accent);
    outline-offset: 4px;
  }

  .project-card__image {
    height: clamp(13.25rem, 19vw, 16rem);
    overflow: hidden;
    background: #eee8e4;
  }

  .project-card__image::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(
      to bottom,
      rgba(10, 10, 10, 0.1) 0%,
      rgba(10, 10, 10, 0.04) 35%,
      rgba(10, 10, 10, 0.84) 100%
    );
    pointer-events: none;
  }

  .project-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 550ms ease;
  }

  .project-card__placeholder {
    display: flex;
    height: clamp(13.25rem, 19vw, 16rem);
    align-items: center;
    justify-content: center;
    background:
      linear-gradient(to bottom, transparent 45%, rgba(10, 10, 10, 0.76)),
      color-mix(in srgb, var(--project-accent) 60%, #f3ebe6);
    color: color-mix(in srgb, var(--project-accent) 25%, #fff);
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0;
  }

  .project-card:hover .project-card__image img,
  .project-card:focus-visible .project-card__image img {
    transform: scale(1.035);
  }

  .project-card__details {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.8rem 0.9rem 0.9rem;
    text-shadow: 0 1px 0.6rem rgba(0, 0, 0, 0.55);
  }

  .project-card__content {
    min-width: 0;
  }

  .project-card__number,
  .project-card__meta {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .project-card h3 {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: 0;
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.7rem;
    padding-top: 0.55rem;
    border-top: 1px solid rgba(255, 255, 255, 0.55);
  }

  .project-card__meta span:last-child {
    flex: none;
    text-align: right;
  }

  .projects-carousel__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 700px) {
    .projects-carousel {
      min-height: 42rem;
    }

    .projects-carousel__stage {
      --carousel-center-x: 50%;
      inset: 3.25rem 0.5rem 1rem;
      min-height: 37rem;
    }

    .projects-carousel__intro {
      width: 38vw;
    }

    .projects-carousel__intro h2 {
      font-size: 3rem;
    }

    .projects-carousel__intro span {
      margin-top: 0.75rem;
      font-size: 0.625rem;
    }

    .projects-carousel__item {
      width: min(48vw, 13rem);
    }

    .project-card__image,
    .project-card__placeholder {
      height: 12.5rem;
    }

    .project-card__placeholder {
      font-size: 2.75rem;
    }

    .project-card__details {
      padding: 0.7rem;
    }

    .project-card__meta {
      gap: 0.4rem;
      margin-top: 0.55rem;
      padding-top: 0.45rem;
      font-size: 0.625rem;
    }

    .project-card h3 {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card__image img {
      transition: none;
    }
  }
</style>
