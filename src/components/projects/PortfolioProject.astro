---
import Footer from "../Footer.astro";

const projectData = {
  id: "portfolio",
  title: "Portfolio Website",
  description:
    "A focused portfolio for presenting selected design and front-end work through a compact, expressive browsing experience.",
  year: "2026",
  role: "UX/UI Design, Front-End Development",
  type: "Creative Portfolio",
  technologies: ["Astro 5", "TypeScript", "Tailwind CSS v4", "CSS Animation"],
  image: {
    src: "/images/design/portfolio-homepage-full.png",
    alt: "Full homepage of Oscar Gizatulin's portfolio website",
  },
  liveUrl: "/",
  githubUrl: "https://github.com/Fr1endly/portfolio",
};

const stack = [
  { layer: "Framework", choice: "Astro 5 + TypeScript" },
  { layer: "Styling", choice: "Tailwind CSS v4 + scoped CSS" },
  { layer: "Typography", choice: "Raleway + Lato" },
  { layer: "Motion", choice: "CSS transforms + requestAnimationFrame" },
  { layer: "Rendering", choice: "Static site generation" },
];
---

<section
  class="case-study relative w-full min-h-screen pt-8 pb-16 px-4 md:px-6"
  data-project="portfolio"
>
  <div class="max-w-5xl mx-auto">
    <header class="mb-16 md:mb-24">
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="case-study__tag case-study__tag--accent type-label inline-block px-3 py-1 border">
          {projectData.id}
        </span>
        <span class="case-study__tag type-label inline-block px-3 py-1 border">
          {projectData.type}
        </span>
      </div>

      <h1 class="type-display text-stone-100 mb-6">{projectData.title}</h1>
      <p class="type-lede text-stone-300 max-w-3xl">{projectData.description}</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20 pb-20 border-b border-stone-800">
      <div>
        <h2 class="type-label text-stone-400 mb-2">Year</h2>
        <p class="type-data text-stone-100 text-2xl">{projectData.year}</p>
      </div>
      <div>
        <h2 class="type-label text-stone-400 mb-2">Role</h2>
        <p class="type-data text-stone-100">{projectData.role}</p>
      </div>
      <div>
        <h2 class="type-label text-stone-400 mb-2">Technologies</h2>
        <div class="flex flex-wrap gap-2">
          {projectData.technologies.map((tech) => <span class="type-meta text-stone-300">{tech}</span>)}
        </div>
      </div>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-8">Project Gallery</h2>
      <div class="case-study__media relative">
        <img
          src={projectData.image.src}
          alt={projectData.image.alt}
          class="block w-full h-auto"
        />
      </div>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-6">The Goal</h2>
      <p class="type-body-lg text-stone-300 max-w-3xl">
        The portfolio needed to communicate both design judgment and technical
        ability without turning into a conventional grid of identical cards.
        It also needed to keep every project visible and easy to reach on a
        single, responsive homepage.
      </p>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-8">Design Direction</h2>
      <div class="space-y-10">
        <div>
          <h3 class="type-subheading text-stone-100 mb-3">Editorial Scale</h3>
          <p class="type-body text-stone-300 max-w-3xl">
            Oversized typography establishes identity immediately, while small
            technical labels and restrained project metadata keep the interface
            precise and easy to scan.
          </p>
        </div>
        <div>
          <h3 class="type-subheading text-stone-100 mb-3">Orbital Project Navigation</h3>
          <p class="type-body text-stone-300 max-w-3xl">
            Projects move around a tilted elliptical path, turning the work
            index into the primary visual interaction. Hover and keyboard focus
            pause the motion so every case study remains accessible.
          </p>
        </div>
        <div>
          <h3 class="type-subheading text-stone-100 mb-3">Responsive Composition</h3>
          <p class="type-body text-stone-300 max-w-3xl">
            The layout recalculates the carousel radius and card scale for each
            viewport, preserving the composition from compact mobile screens to
            wide desktop displays.
          </p>
        </div>
      </div>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-8">Technical Highlights</h2>
      <ul class="space-y-4">
        <li class="flex items-start gap-4">
          <span class="case-study__bullet text-xl mt-1 flex-shrink-0">→</span>
          <span class="type-body-lg text-stone-300">
            <strong class="text-stone-100">Static-first delivery.</strong> Astro
            generates each route as static HTML for a fast initial render with
            minimal client-side JavaScript.
          </span>
        </li>
        <li class="flex items-start gap-4">
          <span class="case-study__bullet text-xl mt-1 flex-shrink-0">→</span>
          <span class="type-body-lg text-stone-300">
            <strong class="text-stone-100">Purpose-built motion.</strong> The
            carousel uses requestAnimationFrame and CSS custom properties to
            calculate position, depth, and scale without a motion dependency.
          </span>
        </li>
        <li class="flex items-start gap-4">
          <span class="case-study__bullet text-xl mt-1 flex-shrink-0">→</span>
          <span class="type-body-lg text-stone-300">
            <strong class="text-stone-100">Accessible interaction.</strong>
            Reduced-motion preferences, focus states, semantic labels, and
            pause behavior are built into the project navigation.
          </span>
        </li>
      </ul>
    </div>

    <div class="mb-20">
      <h2 class="type-section-title text-stone-100 mb-8">Stack Summary</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-4">
        {stack.map((row) => (
          <div class="flex items-baseline gap-3 py-2 border-b border-stone-800">
            <span class="type-label text-stone-400 w-28 flex-shrink-0">{row.layer}</span>
            <span class="type-body text-stone-200">{row.choice}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center mb-12">
      <div>
        <h2 class="type-label text-stone-400 mb-4">Links</h2>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={projectData.liveUrl} class="case-study__action case-study__action--primary type-action px-6 py-2 border transition-colors duration-300">
            Live Site
          </a>
          <a href={projectData.githubUrl} target="_blank" rel="noopener noreferrer" class="case-study__action case-study__action--primary type-action px-6 py-2 border transition-colors duration-300">
            View Code
          </a>
          <a href="/" class="case-study__action type-action px-6 py-2 border transition-colors duration-300">
            ← Back to Home
          </a>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</section>
